{
  "name": "day-count-conventions",
  "version": "1.0.0",
  "description": "ISDA day-count conventions — 30/360, 30E/360, 30E/360-ISDA, 30U/360, ACT/360, ACT/365F, ACT/ACT-ISDA, ACT/ACT-ICMA, ACT/ACT-AFB, BUS/252. Zero dependencies, cross-checked against QuantLib.",
  "keywords": [
    "day-count",
    "daycount",
    "year-fraction",
    "30-360",
    "act-360",
    "act-act",
    "isda",
    "icma",
    "fixed-income",
    "bonds",
    "finance",
    "interest",
    "accrual"
  ],
  "homepage": "https://moshemalka.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshejs/day-count.git"
  },
  "bugs": "https://github.com/moshejs/day-count/issues",
  "author": "Moshe Malka <hello@moshemalka.com> (https://moshemalka.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
